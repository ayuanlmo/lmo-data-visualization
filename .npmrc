# pnpm 配置（详见重构计划 Phase 0）
# deduped：保留 pnpm 的依赖去重能力，同时以真实目录结构落盘，
# 兼容遗留代码中「从依赖方目录解析对等包」的用法（如 express 解析 pug 视图引擎）。
node-linker=deduped
shamefully-hoist=false
strict-peer-dependencies=false
auto-install-peers=false
# 布局变更时允许重建 node_modules（非 TTY 环境下不阻塞安装）
confirmModulesPurge=false
fund=false
audit=false
