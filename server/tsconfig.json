{
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./dist/lmo.t",
    "target": "ES2022",
    "lib": [
      "ESNext"
    ],
    "outDir": "dist",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false
  },
  "include": [
    "bin",
    "conf",
    "const",
    "router",
    "utils",
    "global.d.ts",
    "shims.d.ts",
    "main.ts"
  ],
  "exclude": [
    "gulpfile.js",
    "node_modules",
    "_data/static/public"
  ]
}
